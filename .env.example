# Audit Service (US-11). Copiar a .env y completar. .env no se versiona.

# Puerto de /health, /ready y /health/deps. No se publica fuera de la red de Docker.
PORT=8080

# Cadena de conexión a la base propia (audit-db). Con docker-compose se fija sola.
DATABASE_URL=postgres://audit:audit@localhost:5432/audit?sslmode=disable

# Plazo máximo, en milisegundos, de cada consulta contra la base propia.
DB_QUERY_TIMEOUT_MS=1500

# --- Broker ---
# La topología (exchange, colas de trabajo, .retry y .dlq) la declara solo
# vinculo-vial-core; Audit consume sobre topología existente y no publica eventos.
RABBITMQ_URL=amqp://guest:guest@vinculo-vial-rabbitmq:5672/

# Timeout, en milisegundos, de la publicación a la DLQ, incluida la espera del confirm.
RABBITMQ_PUBLISH_TIMEOUT_MS=2000

# Prefetch (basic.qos) de cada consumidor: mensajes sin ack en vuelo. Entre 1 y 65535.
RABBITMQ_PREFETCH=10

# Reintentos de un mensaje con fallo transitorio (cola .retry con TTL, contados por
# x-death) antes de derivarlo a la DLQ. Con RETRY_TTL_MS=30 s de Core, 10 reintentos
# cubren 5 minutos de desorden entre recorded y delivered/discarded.
MAX_RETRIES=10

# Colas de trabajo. Tienen que coincidir con las que declara vinculo-vial-core.
AUDIT_RECORDED_QUEUE=audit.alert-recorded.q
AUDIT_DELIVERED_QUEUE=audit.alert-delivered.q
AUDIT_DISCARDED_QUEUE=audit.alert-discarded.q

# --- Retención (decisiones legales: sin valor por defecto, son obligatorias) ---
# Días que se conserva un registro, desde la creación de la alerta. Producción: 1095
# (art. 2561 del CCyC; cubre el art. 62 del CP). En desarrollo, un valor bajo (por
# ejemplo 1) para poder ver la destrucción.
AUDIT_RETENTION_DAYS=1095

# Modo de S3 Object Lock. GOVERNANCE en desarrollo; COMPLIANCE solo en producción:
# con COMPLIANCE ni la cuenta root puede borrar antes de tiempo.
AUDIT_OBJECT_LOCK_MODE=GOVERNANCE

# --- S3 (AWS, sin emulador local) ---
# Bucket de Audit: lo crea vinculo-vial-core (privado, SSE-S3, versionado, con Object
# Lock). Tiene que coincidir con AUDIT_BUCKET de Core.
AUDIT_BUCKET=vinculo-vial-audit-dev-reemplazar-sufijo
# Bucket de evidencia: Audit solo lee alerts/*/redacted/*.
EVIDENCE_BUCKET=vinculo-vial-evidence-dev-reemplazar-sufijo
S3_REGION=us-east-1
# Credenciales: cadena estándar del SDK de AWS. En local, solo en .env; en
# producción, rol IAM.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Timeouts, en milisegundos, de las operaciones sobre S3: S3_PUT_TIMEOUT_MS acota
# escrituras, borrados y cambios de legal hold; S3_GET_TIMEOUT_MS acota lecturas
# (incluido el cuerpo) y listados.
S3_PUT_TIMEOUT_MS=5000
S3_GET_TIMEOUT_MS=5000

# Tamaño máximo, en bytes, de un objeto leído (una foto redactada). Por defecto 20 MiB.
S3_MAX_OBJECT_BYTES=20971520

# Circuit breaker, uno por bucket (evidencia y Audit son independientes). Con
# S3_BREAKER_FAILURE_THRESHOLD fallas (timeout, error de conexión, 5xx o 429) dentro
# de S3_BREAKER_WINDOW_MS, el circuito se abre y las llamadas fallan de inmediato
# durante S3_BREAKER_OPEN_DURATION_MS; pasado ese tiempo se admite una llamada de
# prueba. Los 4xx no cuentan.
S3_BREAKER_FAILURE_THRESHOLD=5
S3_BREAKER_WINDOW_MS=30000
S3_BREAKER_OPEN_DURATION_MS=30000

# --- Sweeper ---
# Cada cuánto destruye los registros vencidos sin retención judicial (formato de
# Go: 30m, 1h), y cuántos registros lee por página.
AUDIT_SWEEP_INTERVAL=1h
AUDIT_SWEEP_BATCH_SIZE=500

# --- Prohibido ---
# Audit NUNCA recibe la clave privada de Audit ni las claves AES de otros servicios
# (AES_KEY, PAT_AES_KEY, *_PRIVATE_KEY): si alguna está definida, el servicio no
# arranca.

# --- Solo para las pruebas ---
# TEST_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
